{% extends "layout.njk" %}

{% set pageTitle = site.title %}
{% set pageDescription = site.description %}
{% set canonicalUrl = pathPrefix %}
{% set ogType = "website" %}
{% set ogImage = articles[0].image if articles.length > 0 and articles[0].image else (author.profile.banner if author and author.profile and author.profile.banner else "") %}

{% block additionalHead %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "{{ site.title }}",
  "description": "{{ site.description }}",
  {% if author %}"author": {
    "@type": "Person",
    "name": "{{ author.profile.display_name or author.profile.name }}",
    {% if author.profile.about %}"description": {{ author.profile.about | dump | safe }},{% endif %}
    {% if author.profile.picture %}"image": "{{ author.profile.picture }}",{% endif %}
    {% if author.profile.website %}"url": "{{ author.profile.website }}",{% endif %}
    "sameAs": [
      {% if author.npub %}"https://nosta.me/{{ author.npub }}"{% endif %}{% if author.profile.twitter %},{% endif %}
      {% if author.profile.twitter %}"https://twitter.com/{{ author.profile.twitter }}"{% endif %}{% if author.profile.github %},{% endif %}
      {% if author.profile.github %}"https://github.com/{{ author.profile.github }}"{% endif %}
    ]
  },{% endif %}
  "blogPost": [
    {% for article in articles | take(10) %}
    {
      "@type": "BlogPosting",
      "headline": {{ article.title | dump | safe }},
      {% if article.summary %}"description": {{ article.summary | dump | safe }},{% endif %}
      "url": "{{ pathPrefix }}{{ article.slug }}.html",
      "datePublished": "{{ article.published_at | date('iso') }}",
      {% if article.modified_at %}"dateModified": "{{ (article.modified_at * 1000) | date('iso') }}",{% endif %}
      {% if article.image %}"image": "{{ article.image }}",{% endif %}
      "author": {
        "@type": "Person",
        "name": "{{ author.profile.display_name or author.profile.name }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
<style>
  /* ── Home ─────────────────────────────────────── */

  /* Hero */
  .hero { padding: 2rem 0 4.5rem; }
  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.4rem;
  }
  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    margin-bottom: 1.6rem;
  }
  .hero-title .brand-dot { color: var(--accent); }
  .hero-desc {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    color: var(--ink-muted);
    line-height: 1.7;
    max-width: 58ch;
    margin-bottom: 1.9rem;
  }
  .hero-byline {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
    flex-wrap: wrap;
  }
  .hero-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }
  .hero-avatar-fallback {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--ink-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 650;
  }
  .hero-byline b { color: var(--ink); font-weight: 600; }
  .hero-byline-sep { color: var(--ink-subtle); }

  /* Featured story */
  .featured {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
    border-top: 1px solid var(--border);
    padding: 4rem 0;
  }
  .featured-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-subtle);
    margin-bottom: 1.1rem;
  }
  .featured-title {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 1.1rem;
  }
  .featured-title a { color: inherit; text-decoration: none; transition: color 0.15s; }
  .featured-title a:hover { color: var(--accent); }
  .featured-dek {
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.3rem;
  }
  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-subtle);
    margin-bottom: 1.9rem;
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.15s, transform 0.15s;
  }
  .featured-cta::after { content: '→'; transition: transform 0.15s; }
  .featured-cta:hover { color: var(--accent); }
  .featured-cta:hover::after { transform: translateX(3px); }
  .featured-art {
    display: block;
    text-decoration: none;
  }
  .featured-art img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: block;
    transition: transform 0.35s ease;
  }
  .featured-art:hover img { transform: scale(1.015); }

  /* Section head */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }
  .section-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  @media (max-width: 820px) {
    .featured { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 0; }
    .featured-art { order: -1; }
    .hero { padding: 1rem 0 3.5rem; }
  }
</style>
{% endblock %}

{% block content %}
  {% set featured = articles[0] %}

  <section class="hero">
    <p class="hero-kicker">Blog · Powered by Nostr</p>
    <h1 class="hero-title">{{ site.title }}<span class="brand-dot">.</span></h1>
    {% if site.description %}<p class="hero-desc">{{ site.description | truncate(180) }}</p>{% endif %}
    <div class="hero-byline">
      {% if author.profile.picture %}
        <img src="{{ author.profile.picture }}" alt="" class="hero-avatar" />
      {% else %}
        <div class="hero-avatar-fallback" aria-hidden="true">{{ (author.profile.display_name or author.profile.name or "?")[0] | upper }}</div>
      {% endif %}
      <span><b>{{ author.profile.display_name or author.profile.name or site.title }}</b></span>
      <span class="hero-byline-sep">·</span>
      <span>{{ articles.length }} stories · Censorship-resistant publishing</span>
    </div>
  </section>

  {% if articles.length > 0 %}
  <section class="featured" aria-label="Featured story">
    <div>
      <p class="featured-kicker">Featured story</p>
      <h2 class="featured-title"><a href="{{ pathPrefix }}{{ featured.slug }}.html">{{ featured.title }}</a></h2>
      {% if featured.summary %}<p class="featured-dek">{{ featured.summary }}</p>{% endif %}
      <div class="featured-meta">
        <time datetime="{{ featured.published_at | date('iso') }}">{{ featured.published_at | date("Y-m-d") }}</time>
        {% if featured.readingTime %}<span>·</span><span>{{ featured.readingTime }} min read</span>{% endif %}
      </div>
      <a class="featured-cta" href="{{ pathPrefix }}{{ featured.slug }}.html">Read story</a>
    </div>
    <a class="featured-art" href="{{ pathPrefix }}{{ featured.slug }}.html" aria-hidden="true" tabindex="-1">
      {% if featured.image %}
        <img src="{{ featured.image }}" alt="" loading="eager" fetchpriority="high" />
      {% endif %}
    </a>
  </section>

  {% if articles.length > 1 %}
  <section aria-label="All stories">
    <div class="section-head">
      <span class="section-label">All stories</span>
      <span class="section-count">{{ articles.length - 1 }} more posts</span>
    </div>
    <ul class="post-list" role="list">
      {% for article in articles %}
      {% if not loop.first %}
      <li class="post-item">
        <a href="{{ pathPrefix }}{{ article.slug }}.html" class="post-link">
          <div class="post-body">
            <p class="post-kicker">{% if article.tags.length %}{{ article.tags[0] }}{% else %}Story{% endif %} · Nº {{ loop.index }}</p>
            <h2 class="post-title">{{ article.title }}</h2>
            {% if article.summary %}<p class="post-summary">{{ article.summary }}</p>{% endif %}
            <div class="post-meta">
              <time datetime="{{ article.published_at | date('iso') }}">{{ article.published_at | date("Y-m-d") }}</time>
              {% if article.readingTime %}<span class="post-meta-sep">·</span><span>{{ article.readingTime }} min</span>{% endif %}
            </div>
            {% if article.tags.length %}
              <div class="post-tags">{% for tag in article.tags | take(3) %}<span class="post-tag">#{{ tag }}</span>{% endfor %}</div>
            {% endif %}
          </div>
          <span class="post-thumb-wrap">
            {% if article.image %}
              <img src="{{ article.image }}" alt="" class="post-thumb" loading="lazy" />
            {% else %}
              <span class="post-thumb-fallback">{{ article.title[0] | upper }}</span>
            {% endif %}
          </span>
        </a>
      </li>
      {% endif %}
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  {% else %}
  <p style="color: var(--ink-muted);">No posts yet.</p>
  {% endif %}
{% endblock %}
