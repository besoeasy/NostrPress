{% extends "layout.njk" %}

{% set pageTitle = site.title %}
{% set pageDescription = site.description %}
{% set canonicalUrl = pathPrefix %}
{% set ogType = "website" %}
{% set ogImage = articles[0].image if articles.length > 0 and articles[0].image else (author.profile.banner if author and author.profile and author.profile.banner else "") %}

{% block additionalHead %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "{{ site.title }}",
  "description": "{{ site.description }}",
  {% if author %}"author": {
    "@type": "Person",
    "name": "{{ author.profile.display_name or author.profile.name }}",
    {% if author.profile.about %}"description": {{ author.profile.about | dump | safe }},{% endif %}
    {% if author.profile.picture %}"image": "{{ author.profile.picture }}",{% endif %}
    {% if author.profile.website %}"url": "{{ author.profile.website }}",{% endif %}
    "sameAs": [
      {% if author.npub %}"https://nosta.me/{{ author.npub }}"{% endif %}{% if author.profile.twitter %},{% endif %}
      {% if author.profile.twitter %}"https://twitter.com/{{ author.profile.twitter }}"{% endif %}{% if author.profile.github %},{% endif %}
      {% if author.profile.github %}"https://github.com/{{ author.profile.github }}"{% endif %}
    ]
  },{% endif %}
  "blogPost": [
    {% for article in articles | take(10) %}
    {
      "@type": "BlogPosting",
      "headline": {{ article.title | dump | safe }},
      {% if article.summary %}"description": {{ article.summary | dump | safe }},{% endif %}
      "url": "{{ pathPrefix }}{{ article.slug }}.html",
      "datePublished": "{{ article.published_at | date('iso') }}",
      {% if article.modified_at %}"dateModified": "{{ (article.modified_at * 1000) | date('iso') }}",{% endif %}
      {% if article.image %}"image": "{{ article.image }}",{% endif %}
      "author": {
        "@type": "Person",
        "name": "{{ author.profile.display_name or author.profile.name }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
<style>
  /* ── Front page ─────────────────────────────── */
  .cover {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 5px 5px 0 var(--border-strong);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .cover:hover {
    transform: translateY(-2px);
    box-shadow: 7px 7px 0 var(--border-strong);
  }
  .cover-art {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface-alt);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    display: block;
  }
  .cover-art img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .cover:hover .cover-art img {
    transform: scale(1.02);
  }
  .cover-art-fallback {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--border-strong);
    background: repeating-linear-gradient(-45deg, transparent 0 14px, rgba(0,0,0,0.05) 14px 15px), var(--surface-alt);
  }
  .cover-main {
    padding: clamp(1.4rem, 3.5vw, 2.2rem);
    display: flex;
    flex-direction: column;
  }
  .cover-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .kicker {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--surface); background: var(--accent); padding: 0.3rem 0.7rem; border-radius: 100px;
    width: fit-content;
  }
  .kicker.alt { background: var(--ink); color: var(--paper); }
  .cover-title {
    font-family: var(--font-display); font-weight: 900; letter-spacing: -0.03em; line-height: 1.1;
    font-size: clamp(1.8rem, 4vw, 2.75rem); margin-bottom: 0.85rem;
  }
  .cover-title a { color: inherit; text-decoration: none; }
  .cover-title a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .cover-dek {
    font-family: var(--font-display); font-style: italic; font-size: clamp(1rem, 2vw, 1.18rem);
    color: var(--ink-muted); line-height: 1.55; margin-bottom: 1.35rem;
  }
  .cover-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--border);
  }
  .byline { display: flex; align-items: center; gap: 0.7rem; }
  .byline-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-strong); }
  .byline-avatar-fallback { width: 38px; height: 38px; border-radius: 50%; background: var(--ink); color: var(--paper); display: flex; align-items: center; justify-content: center; font-weight: 800; font-family: var(--font-display); }
  .byline-name { font-weight: 700; font-size: 0.9rem; }
  .byline-date { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-subtle); }
  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--ink); color: var(--paper); text-decoration: none; font-weight: 700; font-size: 0.9rem;
    padding: 0.65rem 1.2rem; border-radius: 100px; border: 1px solid var(--ink); width: fit-content;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .btn:hover { transform: translate(-1px,-1px); box-shadow: 3px 3px 0 var(--accent); }

  .section-bar {
    display: flex; align-items: center; gap: 0.9rem; margin: 1.8rem auto 1.1rem;
    max-width: 780px;
  }
  .section-bar h2 { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.2em; text-transform: uppercase; background: var(--ink); color: var(--paper); padding: 0.35rem 0.8rem; border-radius: 100px; white-space: nowrap; }
  .section-bar::after { content: ''; flex: 1; height: 2px; background: var(--border-strong); }
  .section-count { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-subtle); white-space: nowrap; }

  /* ── Single-column story list ─────────────── */
  .stories { max-width: 780px; margin: 0 auto; }
  .stories .post-list { grid-template-columns: 1fr; }
  .stories .post-link { flex-direction: row; align-items: stretch; }
  .stories .post-thumb-wrap {
    width: 240px; min-width: 240px; aspect-ratio: 16 / 9;
    border-bottom: none; border-right: 1px solid var(--border);
    flex-shrink: 0;
  }
  .stories .post-body { padding: 1.25rem 1.35rem; justify-content: center; }
  .stories .post-title { font-size: 1.35rem; }
  @media (max-width: 640px) {
    .stories .post-link { flex-direction: column; }
    .stories .post-thumb-wrap {
      width: 100%; min-width: 0; aspect-ratio: 16 / 9; min-height: 0;
      border-right: none; border-bottom: 1px solid var(--border);
    }
  }
</style>
{% endblock %}

{% block content %}
  {% if articles.length > 0 %}
    {% set featured = articles[0] %}
    <article class="cover">
      <a class="cover-art" href="{{ pathPrefix }}{{ featured.slug }}.html" aria-label="{{ featured.title }}">
        {% if featured.image %}
          <img src="{{ featured.image }}" alt="{{ featured.title }}" loading="eager" />
        {% else %}
          <div class="cover-art-fallback">{{ featured.title[0] | upper }}</div>
        {% endif %}
      </a>
      <div class="cover-main">
        <div class="cover-meta-top">
          <span class="kicker">★ Cover story</span>
          <div class="byline-date"><time datetime="{{ featured.published_at | date('iso') }}">{{ featured.published_at | date("Y-m-d") }}</time>{% if featured.readingTime %} · {{ featured.readingTime }} min read{% endif %}</div>
        </div>
        <h1 class="cover-title"><a href="{{ pathPrefix }}{{ featured.slug }}.html">{{ featured.title }}</a></h1>
        {% if featured.summary %}<p class="cover-dek">{{ featured.summary }}</p>{% endif %}
        <div class="cover-footer">
          <div class="byline">
            {% if author.profile.picture %}
              <img src="{{ author.profile.picture }}" alt="" class="byline-avatar" />
            {% else %}
              <div class="byline-avatar-fallback">{{ (author.profile.display_name or author.profile.name or "?")[0] | upper }}</div>
            {% endif %}
            <div class="byline-name">{{ author.profile.display_name or author.profile.name or site.title }}</div>
          </div>
          <a class="btn" href="{{ pathPrefix }}{{ featured.slug }}.html">Read story →</a>
        </div>
      </div>
    </article>

    <div class="stories">
        <div class="section-bar"><h2>Latest stories</h2><span class="section-count">{{ articles.length }} articles</span></div>
        <ul class="post-list" role="list">
          {% for article in articles | take(999) %}
          {% if not loop.first %}
          <li class="post-item">
            <a href="{{ pathPrefix }}{{ article.slug }}.html" class="post-link">
              <span class="post-thumb-wrap">
                {% if article.image %}
                  <img src="{{ article.image }}" alt="" class="post-thumb" loading="lazy" />
                {% else %}
                  <span class="post-thumb-fallback">{{ article.title[0] | upper }}</span>
                {% endif %}
              </span>
              <div class="post-body">
                <p class="post-kicker">{% if article.tags.length %}{{ article.tags[0] }}{% else %}Story{% endif %} · Nº {{ loop.index }}</p>
                <h2 class="post-title">{{ article.title }}</h2>
                {% if article.summary %}<p class="post-summary">{{ article.summary }}</p>{% endif %}
                <div class="post-meta">
                  <time datetime="{{ article.published_at | date('iso') }}">{{ article.published_at | date("Y-m-d") }}</time>
                  {% if article.readingTime %}<span class="post-meta-sep">·</span><span>{{ article.readingTime }} min</span>{% endif %}
                </div>
                {% if article.tags.length %}
                  <div class="post-tags">{% for tag in article.tags | take(3) %}<span class="post-tag">#{{ tag }}</span>{% endfor %}</div>
                {% endif %}
              </div>
            </a>
          </li>
          {% endif %}
          {% endfor %}
        </ul>
    </div>
  {% else %}
    <p style="color: var(--ink-muted);">No posts yet.</p>
  {% endif %}
{% endblock %}
