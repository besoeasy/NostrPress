{% extends "layout.njk" %}

{% set pageTitle = site.title ~ " · " ~ (author.profile.display_name or author.profile.name or author.npub) %}
{% set pageDescription = author.profile.about or site.description %}
{% set canonicalUrl = pathPrefix ~ "author/" %}
{% set ogType = "profile" %}
{% set ogImage = author.profile.picture or "" %}

{% block additionalHead %}
<style>
  .author-sheet {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 5px 5px 0 var(--border-strong);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 1.25rem;
  }
  .author-banner-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    background: var(--surface-alt);
  }
  .author-banner {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .author-page-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .author-page-avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border-strong);
    flex-shrink: 0;
  }
  .author-page-avatar-placeholder {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    border: 3px solid var(--border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 900;
    flex-shrink: 0;
  }
  .author-page-meta { flex: 1; min-width: 0; }
  .author-page-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 0.35rem;
  }
  .author-page-npub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-subtle);
    margin-bottom: 0.625rem;
    word-break: break-all;
  }
  .author-page-bio {
    font-size: 0.95rem;
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 52ch;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .section-label span { background: var(--ink); color: var(--paper); padding: 0.3rem 0.8rem; border-radius: 100px; white-space: nowrap; }
  .section-label::after { content: ''; flex: 1; height: 2px; background: var(--border-strong); }
</style>
{% endblock %}

{% block content %}
<div class="author-sheet">
  {% if author and author.profile and author.profile.banner %}
    <div class="author-banner-wrap">
      <img src="{{ author.profile.banner }}" alt="{{ author.profile.display_name or author.profile.name }}" class="author-banner" loading="eager" />
    </div>
  {% endif %}
  <header class="author-page-header">
    {% if author.profile.picture %}
      <img src="{{ author.profile.picture }}" alt="{{ author.profile.display_name or author.profile.name }}" class="author-page-avatar" />
    {% else %}
      <div class="author-page-avatar-placeholder" aria-hidden="true">
        {{ (author.profile.display_name or author.profile.name or "?")[0] | upper }}
      </div>
    {% endif %}
    <div class="author-page-meta">
      <h1 class="author-page-name">{{ author.profile.display_name or author.profile.name or author.npub }}</h1>
      {% if author.npub %}
        <p class="author-page-npub">{{ author.npub }}</p>
      {% endif %}
      {% if author.profile.about %}
        <p class="author-page-bio">{{ author.profile.about }}</p>
      {% endif %}
    </div>
  </header>
</div>

  {% if articles.length > 0 %}
    <p class="section-label"><span>Archive · {{ articles.length }}</span></p>
    <ul class="post-list" role="list">
      {% for article in articles %}
      <li class="post-item">
        <a href="{{ pathPrefix }}{{ article.slug }}.html" class="post-link">
          <span class="post-thumb-wrap">
            {% if article.image %}
              <img src="{{ article.image }}" alt="" class="post-thumb" loading="lazy" />
            {% else %}
              <span class="post-thumb-fallback">{{ article.title[0] | upper }}</span>
            {% endif %}
          </span>
          <div class="post-body">
            <h2 class="post-title">{{ article.title }}</h2>
            {% if article.summary %}
              <p class="post-summary">{{ article.summary }}</p>
            {% endif %}
            <div class="post-meta">
              <time datetime="{{ article.published_at | date('iso') }}">{{ article.published_at | date("Y-m-d") }}</time>
              {% if article.readingTime %}
                <span class="post-meta-sep">·</span>
                <span>{{ article.readingTime }} min</span>
              {% endif %}
            </div>
          </div>
        </a>
      </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endblock %}
