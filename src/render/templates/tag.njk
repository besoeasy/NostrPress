{% extends "layout.njk" %}

{% set pageTitle = "#" ~ tag ~ " · " ~ site.title %}
{% set pageDescription = "Articles tagged with #" ~ tag %}
{% set canonicalUrl = pathPrefix ~ "tags/" ~ (tagSlug or tag) ~ "/" %}
{% set ogType = "website" %}
{% set ogImage = "" %}

{% block additionalHead %}
<style>
  .tag-sheet {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 5px 5px 0 var(--border-strong);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .tag-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 100px;
    background: var(--paper);
    transition: all 0.15s;
  }
  .tag-back:hover { background: var(--ink); color: var(--paper); }
  .tag-back svg { width: 15px; height: 15px; }

  .tag-header { margin-bottom: 1.75rem; }
  .tag-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--surface);
    background: var(--accent);
    padding: 0.3rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 0.75rem;
  }
  .tag-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .tag-count {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
</style>
{% endblock %}

{% block content %}
<div class="tag-sheet">
  <a href="{{ pathPrefix }}" class="tag-back" aria-label="Back to front page">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Front page
  </a>

  <header class="tag-header">
    <p class="tag-eyebrow">Filed under</p>
    <h1 class="tag-title">#{{ tag }}</h1>
    <p class="tag-count">{{ articles.length }} {{ 'story' if articles.length == 1 else 'stories' }}</p>
  </header>

  <ul class="post-list" role="list">
    {% for article in articles %}
    <li class="post-item">
      <a href="{{ pathPrefix }}{{ article.slug }}.html" class="post-link">
        <span class="post-thumb-wrap">
          {% if article.image %}
            <img src="{{ article.image }}" alt="" class="post-thumb" loading="lazy" />
          {% else %}
            <span class="post-thumb-fallback">{{ article.title[0] | upper }}</span>
          {% endif %}
        </span>
        <div class="post-body">
          <h2 class="post-title">{{ article.title }}</h2>
          {% if article.summary %}
            <p class="post-summary">{{ article.summary }}</p>
          {% endif %}
          <div class="post-meta">
            <time datetime="{{ article.published_at | date('iso') }}">{{ article.published_at | date("Y-m-d") }}</time>
            {% if article.readingTime %}
              <span class="post-meta-sep">·</span>
              <span>{{ article.readingTime }} min</span>
            {% endif %}
          </div>
        </div>
      </a>
    </li>
    {% endfor %}
  </ul>
</div>
{% endblock %}
