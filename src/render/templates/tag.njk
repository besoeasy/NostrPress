{% extends "layout.njk" %}

{% set pageTitle = "#" ~ tag ~ " · " ~ site.title %}
{% set pageDescription = "Articles tagged with #" ~ tag %}
{% set canonicalUrl = pathPrefix ~ "tags/" ~ (tagSlug or tag) ~ "/" %}
{% set ogType = "website" %}
{% set ogImage = "" %}

{% block additionalHead %}
<style>
  /* ── Tag page ─────────────────────────────── */
  .tag-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    text-decoration: none;
    margin-bottom: 3rem;
    transition: color 0.15s;
  }
  .tag-back:hover { color: var(--ink); }
  .tag-back svg { width: 15px; height: 15px; }
  .tag-header { margin-bottom: 3.5rem; }
  .tag-title {
    font-size: clamp(2.6rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
    color: var(--ink);
  }
  .tag-count {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-subtle);
  }
</style>
{% endblock %}

{% block content %}
<div>
  <a href="{{ pathPrefix }}" class="tag-back" aria-label="Back to front page">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Front page
  </a>

  <header class="tag-header">
    <h1 class="tag-title">#{{ tag }}</h1>
    <p class="tag-count">{{ articles.length }} {{ 'story' if articles.length == 1 else 'stories' }}</p>
  </header>

  <ul class="post-list" role="list">
    {% for article in articles %}
    <li class="post-item">
      <a href="{{ pathPrefix }}{{ article.slug }}.html" class="post-link">
        <div class="post-body">
          <h2 class="post-title">{{ article.title }}</h2>
          {% if article.summary %}
            <p class="post-summary">{{ article.summary }}</p>
          {% endif %}
          <div class="post-meta">
            <time datetime="{{ article.published_at | date('iso') }}">{{ article.published_at | date("Y-m-d") }}</time>
            {% if article.readingTime %}
              <span class="post-meta-sep">·</span>
              <span>{{ article.readingTime }} min</span>
            {% endif %}
          </div>
        </div>
        <span class="post-thumb-wrap">
          {% if article.image %}
            <img src="{{ article.image | depth(pathPrefix) }}" alt="" class="post-thumb" loading="lazy" />
          {% else %}
            <span class="post-thumb-fallback">{{ article.title[0] | upper }}</span>
          {% endif %}
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
</div>
{% endblock %}
