<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="author" content="{{ author.profile.display_name or author.profile.name or site.title }}" />
    <meta name="generator" content="NostrPress" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" id="theme-color-meta" content="#ffffff" />
    {% if canonicalUrl %}
    <link rel="canonical" href="{{ canonicalUrl }}" />
    {% endif %}
    {% if site.url %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS Feed" href="{{ site.url }}/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="{{ site.title }} JSON Feed" href="{{ site.url }}/feed.json" />
    {% endif %}

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/x-icon" href="{{ pathPrefix }}favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ pathPrefix }}apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="{{ pathPrefix }}favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="{{ pathPrefix }}favicon-16x16.png" />

    <!-- Open Graph -->
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:locale" content="en_US" />
    {% if canonicalUrl %}
    <meta property="og:url" content="{{ canonicalUrl }}" />
    {% endif %}
    {% if ogImage %}
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:secure_url" content="{{ ogImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ pageTitle }}" />
    {% endif %}
    {% if ogType == 'article' %}
    <meta property="article:published_time" content="{{ article.published_at | date('iso') }}" />
    {% if article.modified_at %}
    <meta property="article:modified_time" content="{{ article.modified_at * 1000 | date('iso') }}" />
    {% endif %}
    <meta property="article:author" content="{{ author.profile.display_name or author.profile.name }}" />
    {% for tag in article.tags %}
    <meta property="article:tag" content="{{ tag }}" />
    {% endfor %}
    {% endif %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    {% if ogImage %}
    <meta name="twitter:image" content="{{ ogImage }}" />
    <meta name="twitter:image:alt" content="{{ pageTitle }}" />
    {% endif %}
    {% if author.profile.twitter %}
    <meta name="twitter:creator" content="@{{ author.profile.twitter }}" />
    {% endif %}

    <!-- Nostr Metadata -->
    {% if author.npub %}
    <meta name="nostr:npub" content="{{ author.npub }}" />
    {% if author.profile.lud16 %}
    <meta name="lightning" content="{{ author.profile.lud16 }}" />
    {% endif %}
    {% endif %}

    {% block additionalHead %}{% endblock %}

    <!-- Editorial fonts: Fraunces (display serif) + Inter (sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script>
      /* Apply theme before first paint to avoid flash of wrong theme */
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored || "light";
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.getElementById("theme-color-meta");
          if (meta) meta.setAttribute("content", theme === "dark" ? "#100e0b" : "#faf8f3");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <link rel="stylesheet" href="{{ pathPrefix }}css/site.css" />
    <link rel="stylesheet" href="{{ pathPrefix }}css/print.css" media="print" />
    <style>
      /* ── Vercel-inspired design system ─────────────── */
      :root {
        color-scheme: light;
        --paper: #ffffff;
        --ink: #171717;
        --ink-muted: #6b6b6b;
        --ink-subtle: #8f8f8f;
        --surface: #ffffff;
        --surface-alt: #fafafa;
        --surface-raised: #f0f0f0;
        --border: #eaeaea;
        --border-light: #f1f1f1;
        --border-strong: #171717;
        --accent: #0070f3;
        --accent-deep: #0058c2;
        --accent-warm: #0070f3;
        --gold: #f5a623;
        --prose-ink: #2e2e2e;
        --code-bg: #161616;
        --code-ink: #ededed;
        --selection: #0070f3;
        --selection-ink: #ffffff;
        --radius: 12px;
        --radius-sm: 8px;
        --font-display: "Inter", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        --font-sans: "Inter", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
        --max-w: 1040px;
        --max-w-prose: 720px;
        font-size: 16px;
      }

      /* Dark palette — Geist black */
      :root[data-theme="dark"] {
        color-scheme: dark;
        --paper: #0a0a0a;
        --ink: #ededed;
        --ink-muted: #a1a1a1;
        --ink-subtle: #6f6f6f;
        --surface: #111111;
        --surface-alt: #171717;
        --surface-raised: #1f1f1f;
        --border: #262626;
        --border-light: #1f1f1f;
        --border-strong: #ededed;
        --accent: #3291ff;
        --accent-deep: #7ab8ff;
        --accent-warm: #3291ff;
        --gold: #fbbf24;
        --prose-ink: #d6d6d6;
        --code-bg: #161616;
        --code-ink: #ededed;
        --selection: #3291ff;
        --selection-ink: #0a0a0a;
      }

      /* System dark fallback (JS disabled) */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) {
          color-scheme: dark;
          --paper: #0a0a0a;
          --ink: #ededed;
          --ink-muted: #a1a1a1;
          --ink-subtle: #6f6f6f;
          --surface: #111111;
          --surface-alt: #171717;
          --surface-raised: #1f1f1f;
          --border: #262626;
          --border-light: #1f1f1f;
          --border-strong: #ededed;
          --accent: #3291ff;
          --accent-deep: #7ab8ff;
          --accent-warm: #3291ff;
          --gold: #fbbf24;
          --prose-ink: #d6d6d6;
          --code-bg: #161616;
          --code-ink: #ededed;
          --selection: #3291ff;
          --selection-ink: #0a0a0a;
        }
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; }

      /* Respect reduced-motion preferences */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Minimal custom scrollbar */
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }
      ::-webkit-scrollbar-thumb:hover { background: var(--ink-subtle); }
      * { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }

      /* Focus ring */
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }

      body {
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        line-height: 1.7;
        background: var(--paper);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        font-optical-sizing: auto;
      }

      /* Typography refinements */
      h1, h2, h3, h4 { text-wrap: balance; letter-spacing: -0.03em; }
      p { text-wrap: pretty; }
      time { font-variant-numeric: tabular-nums; }

      /* Skip link */
      .skip-link {
        position: absolute;
        top: -60px;
        left: 1rem;
        z-index: 9999;
        background: var(--ink);
        color: var(--paper);
        padding: 0.5rem 1rem;
        border-radius: 0 0 6px 6px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: top 0.2s;
      }
      .skip-link:focus { top: 0; }

      /* ── Topbar / Header ──────────────────────────── */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--paper) 82%, transparent);
        backdrop-filter: blur(14px) saturate(1.6);
        -webkit-backdrop-filter: blur(14px) saturate(1.6);
        border-bottom: 1px solid var(--border);
      }
      .topbar-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        height: 64px;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.75rem;
      }
      .topbar-brand {
        text-decoration: none;
        color: var(--ink);
        font-weight: 650;
        font-size: 0.97rem;
        letter-spacing: -0.02em;
        white-space: nowrap;
      }
      .brand-dot { color: var(--accent); }
      .topbar-nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
      }
      .topbar-link {
        font-size: 0.875rem;
        color: var(--ink-muted);
        text-decoration: none;
        padding: 0.375rem 0.625rem;
        border-radius: 8px;
        transition: color 0.15s, background 0.15s;
      }
      .topbar-link:hover { color: var(--ink); background: var(--surface-alt); }
      .topbar-link.active { color: var(--ink); font-weight: 600; }
      .topbar-meta {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--ink-subtle);
      }

      /* ── Main layout ─────────────────────────────────── */
      .site-main {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 3.5rem 1.5rem 7rem;
      }

      /* ── Footer ─────────────────────────────────────── */
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 4.5rem 0 2.5rem;
        margin-top: 1rem;
      }
      .footer-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 3rem;
      }
      @media (max-width: 800px) { .footer-inner { grid-template-columns: 1fr; gap: 2.25rem; } }
      .footer-brand {
        font-weight: 650;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        margin-bottom: 0.9rem;
        color: var(--ink);
      }
      .footer-brand .brand-dot { color: var(--accent); }
      .footer-text {
        font-size: 0.9rem;
        color: var(--ink-muted);
        line-height: 1.7;
        max-width: 40ch;
      }
      .footer-text a {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--border);
        font-weight: 500;
      }
      .footer-text a:hover { text-decoration-color: var(--ink); }
      .footer-h {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-subtle);
        margin-bottom: 1.1rem;
      }
      .footer-links { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; }
      .footer-links a {
        color: var(--ink-muted);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.15s;
      }
      .footer-links a:hover { color: var(--ink); }
      .footer-bottom {
        max-width: var(--max-w);
        margin: 3rem auto 0;
        padding: 0 1.5rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: var(--ink-subtle);
      }

      /* ── Page enter animation ─────────────────────────── */
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .page-enter { animation: fadeUp 0.45s ease-out both; }
      .page-enter > *:nth-child(2) { animation-delay: 0.05s; }

      /* ── Selection highlight ──────────────────────────── */
      ::selection { background: color-mix(in srgb, var(--accent) 18%, transparent); }

      /* ── Story list (index / tag) ─────────────────────── */
      .post-list {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr;
      }
      .post-item {
        border-top: 1px solid var(--border);
        padding: 2.4rem 0;
      }
      .post-link {
        display: grid;
        grid-template-columns: 1fr 216px;
        gap: 2.25rem;
        align-items: flex-start;
        text-decoration: none;
        color: inherit;
      }
      .post-body { min-width: 0; }
      .post-kicker {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        font-weight: 500;
        margin-bottom: 0.7rem;
      }
      .post-title {
        font-size: 1.55rem;
        font-weight: 650;
        letter-spacing: -0.025em;
        line-height: 1.22;
        margin-bottom: 0.7rem;
        transition: color 0.15s;
      }
      .post-link:hover .post-title { color: var(--accent); }
      .post-summary {
        font-size: 0.96rem;
        color: var(--ink-muted);
        line-height: 1.7;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .post-meta {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--ink-subtle);
      }
      .post-meta-sep { opacity: 0.5; }
      .post-tags { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.9rem; }
      .post-tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.01em;
        color: var(--ink-muted);
        text-decoration: none;
        transition: color 0.15s;
      }
      .post-tag:hover { color: var(--accent); }
      .post-thumb-wrap {
        display: block;
        width: 216px;
        aspect-ratio: 16 / 10;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
      }
      .post-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
      }
      .post-link:hover .post-thumb { transform: scale(1.03); }
      .post-thumb-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 650;
        font-size: 2rem;
        color: var(--ink-subtle);
        background: var(--surface-alt);
      }

      /* ── Theme toggle ────────────────────────────────── */
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: none;
        background: transparent;
        color: var(--ink-muted);
        cursor: pointer;
        font-family: inherit;
        transition: background 0.15s, color 0.15s;
      }
      .theme-toggle:hover { color: var(--ink); background: var(--surface-alt); }
      .theme-toggle svg { width: 16px; height: 16px; }
      .theme-toggle .icon-sun { display: none; }
      :root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
      :root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }

      @media (max-width: 640px) {
        .topbar-inner { height: 56px; padding: 0 1rem; gap: 1rem; }
        .topbar-link { font-size: 0.8125rem; padding: 0.3rem 0.45rem; }
        .hide-sm { display: none; }
        .site-main { padding: 2.5rem 1rem 5rem; }
        .post-link { grid-template-columns: 1fr; gap: 1.25rem; }
        .post-thumb-wrap { order: -1; width: 100%; aspect-ratio: 16 / 9; }
        .post-title { font-size: 1.3rem; }
        .footer-inner { padding: 0 1rem; }
        .footer-bottom { padding: 0 1rem; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

      <div class="topbar" role="banner">
        <div class="topbar-inner">
          <a href="{{ pathPrefix }}" class="topbar-brand" aria-label="{{ site.title }} — Home"><span>{{ site.title }}</span><span class="brand-dot">.</span></a>
          <nav class="topbar-nav" aria-label="Site navigation">
            <a href="{{ pathPrefix }}" class="topbar-link active">Latest</a>
            {% if author.profile.website %}
            <a href="{{ author.profile.website }}" target="_blank" rel="noopener noreferrer" class="topbar-link">Website</a>
            {% endif %}
            {% if author.npub %}
            <a href="https://nosta.me/{{ author.npub }}" target="_blank" rel="noopener noreferrer" class="topbar-link">Nostr</a>
            {% endif %}
            {% if site.url %}
            <a href="{{ site.url }}/feed.xml" target="_blank" rel="noopener noreferrer" class="topbar-link">RSS</a>
            {% endif %}
          </nav>
          <div class="topbar-meta">
            <span class="hide-sm">{% if articles %}{{ articles.length }} stories{% endif %}</span>
            <button
              class="theme-toggle"
              id="theme-toggle"
              type="button"
              aria-label="Toggle dark mode"
              title="Toggle dark mode"
            >
              <svg class="icon-moon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              <svg class="icon-sun" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            </button>
          </div>
        </div>
      </div>


    <main id="main-content" class="site-main page-enter" role="main">
      {% block content %}{% endblock %}
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="footer-inner">
        <div>
          <p class="footer-brand">{{ site.title }}<span class="brand-dot">.</span></p>
          <p class="footer-text">{{ site.description | truncate(160) if site.description else 'Long-form writing published on Nostr.' }} Built with <a href="https://github.com/besoeasy/NostrPress" target="_blank" rel="noopener noreferrer">NostrPress</a>.</p>
        </div>
        <div>
          <p class="footer-h">Explore</p>
          <ul class="footer-links">
            <li><a href="{{ pathPrefix }}">Latest stories</a></li>
            {% if site.url %}<li><a href="{{ site.url }}/feed.xml">RSS feed</a></li>
            <li><a href="{{ site.url }}/feed.json">JSON feed</a></li>
            <li><a href="{{ site.url }}/sitemap.xml">Sitemap</a></li>{% endif %}
            {% if author.profile.website %}<li><a href="{{ author.profile.website }}" target="_blank" rel="noopener noreferrer">Author website</a></li>{% endif %}
          </ul>
        </div>
        <div>
          <p class="footer-h">Nostr</p>
          <ul class="footer-links">
            {% if author and author.npub %}
            <li><a href="https://nosta.me/{{ author.npub }}" target="_blank" rel="noopener noreferrer">Profile on Nosta</a></li>
            <li><a href="https://primal.net/p/{{ author.npub }}" target="_blank" rel="noopener noreferrer">Profile on Primal</a></li>
            {% endif %}
            <li><a href="https://github.com/besoeasy/NostrPress" target="_blank" rel="noopener noreferrer">NostrPress source</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {{ site.title }} — via Nostr</span>
        <span>Censorship-resistant publishing</span>
      </div>
    </footer>

    <script src="{{ pathPrefix }}js/site.js" defer></script>
  </body>
</html>
