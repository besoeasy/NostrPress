<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="author" content="{{ author.profile.display_name or author.profile.name or site.title }}" />
    <meta name="generator" content="NostrPress" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" id="theme-color-meta" content="#ffffff" />
    {% if canonicalUrl %}
    <link rel="canonical" href="{{ canonicalUrl }}" />
    {% endif %}
    {% if site.url %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS Feed" href="{{ site.url }}/feed.xml" />
    {% endif %}

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/x-icon" href="{{ pathPrefix }}favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ pathPrefix }}apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="{{ pathPrefix }}favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="{{ pathPrefix }}favicon-16x16.png" />

    <!-- Open Graph -->
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:locale" content="en_US" />
    {% if canonicalUrl %}
    <meta property="og:url" content="{{ canonicalUrl }}" />
    {% endif %}
    {% if ogImage %}
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:secure_url" content="{{ ogImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ pageTitle }}" />
    {% endif %}
    {% if ogType == 'article' %}
    <meta property="article:published_time" content="{{ article.published_at | date('iso') }}" />
    {% if article.modified_at %}
    <meta property="article:modified_time" content="{{ article.modified_at * 1000 | date('iso') }}" />
    {% endif %}
    <meta property="article:author" content="{{ author.profile.display_name or author.profile.name }}" />
    {% for tag in article.tags %}
    <meta property="article:tag" content="{{ tag }}" />
    {% endfor %}
    {% endif %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    {% if ogImage %}
    <meta name="twitter:image" content="{{ ogImage }}" />
    <meta name="twitter:image:alt" content="{{ pageTitle }}" />
    {% endif %}
    {% if author.profile.twitter %}
    <meta name="twitter:creator" content="@{{ author.profile.twitter }}" />
    {% endif %}

    <!-- Nostr Metadata -->
    {% if author.npub %}
    <meta name="nostr:npub" content="{{ author.npub }}" />
    {% if author.profile.lud16 %}
    <meta name="lightning" content="{{ author.profile.lud16 }}" />
    {% endif %}
    {% endif %}

    {% block additionalHead %}{% endblock %}

    <!-- Inter variable font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&display=swap" rel="stylesheet" />

    <script>
      /* Apply theme before first paint to avoid flash of wrong theme */
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.getElementById("theme-color-meta");
          if (meta) meta.setAttribute("content", theme === "dark" ? "#0f172a" : "#ffffff");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <link rel="stylesheet" href="{{ pathPrefix }}css/site.css" />
    <link rel="stylesheet" href="{{ pathPrefix }}css/print.css" media="print" />
    <style>
      /* ── Design tokens ─────────────────────────────── */
      :root {
        color-scheme: light;
        --ink: #111827;
        --ink-muted: #6b7280;
        --ink-subtle: #9ca3af;
        --surface: #ffffff;
        --surface-alt: #f9fafb;
        --surface-raised: #f3f4f6;
        --border: #e5e7eb;
        --border-light: #f3f4f6;
        --accent: #2563eb;
        --accent-warm: #c2410c;
        --prose-ink: #1f2937;
        --code-bg: #1e293b;
        --code-ink: #e2e8f0;
        --selection: #2563eb;
        --selection-ink: #ffffff;
        --radius: 12px;
        --radius-sm: 8px;
        font-size: 16px;
      }

      /* Dark palette (manual toggle or system preference) */
      :root[data-theme="dark"] {
        color-scheme: dark;
        --ink: #f1f5f9;
        --ink-muted: #94a3b8;
        --ink-subtle: #64748b;
        --surface: #0f172a;
        --surface-alt: #1e293b;
        --surface-raised: #1e293b;
        --border: #1e293b;
        --border-light: #1e293b;
        --accent: #60a5fa;
        --accent-warm: #fbbf24;
        --prose-ink: #cbd5e1;
        --code-bg: #0f172a;
        --code-ink: #e2e8f0;
        --selection: #60a5fa;
        --selection-ink: #0f172a;
      }

      /* System dark fallback (JS disabled) */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) {
          color-scheme: dark;
          --ink: #f1f5f9;
          --ink-muted: #94a3b8;
          --ink-subtle: #64748b;
          --surface: #0f172a;
          --surface-alt: #1e293b;
          --surface-raised: #1e293b;
          --border: #1e293b;
          --border-light: #1e293b;
          --accent: #60a5fa;
          --accent-warm: #fbbf24;
          --prose-ink: #cbd5e1;
          --code-bg: #0f172a;
          --code-ink: #e2e8f0;
          --selection: #60a5fa;
          --selection-ink: #0f172a;
        }
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; }

      /* Respect reduced-motion preferences */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Minimal custom scrollbar */
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }
      ::-webkit-scrollbar-thumb:hover { background: var(--ink-subtle); }
      * { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }

      /* Focus ring */
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 3px;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-optical-sizing: auto;
        font-feature-settings: "cv11", "ss01";
        background: var(--surface);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        line-height: 1.6;
      }

      /* Typography refinements */
      h1, h2, h3, h4 { text-wrap: balance; }
      p { text-wrap: pretty; }
      time { font-variant-numeric: tabular-nums; }

      /* Skip link */
      .skip-link {
        position: absolute;
        top: -60px;
        left: 1rem;
        z-index: 9999;
        background: var(--ink);
        color: var(--surface);
        padding: 0.5rem 1rem;
        border-radius: 0 0 6px 6px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: top 0.2s;
      }
      .skip-link:focus { top: 0; }

      /* ── Site header ─────────────────────────────────── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--surface) 85%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-light);
      }
      .header-inner {
        max-width: 720px;
        margin: 0 auto;
        padding: 0.875rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .header-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.0625rem;
        letter-spacing: -0.025em;
        transition: opacity 0.15s;
      }
      .header-brand:hover { opacity: 0.7; }
      .header-brand svg {
        width: 20px;
        height: 20px;
        color: var(--accent);
        flex-shrink: 0;
      }
      .header-nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }
      .header-nav-link {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--ink-muted);
        text-decoration: none;
        padding: 0.375rem 0.625rem;
        border-radius: var(--radius-sm);
        transition: color 0.15s, background 0.15s;
      }
      .header-nav-link:hover {
        color: var(--ink);
        background: var(--surface-alt);
      }

      /* ── Main layout ─────────────────────────────────── */
      .site-main {
        min-height: calc(100vh - 120px);
        max-width: 720px;
        margin: 0 auto;
        padding: 3rem 1.5rem 4rem;
      }

      /* ── Footer ─────────────────────────────────────── */
      .site-footer {
        border-top: 1px solid var(--border);
      }
      .footer-inner {
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-text {
        font-size: 0.8125rem;
        color: var(--ink-subtle);
        display: flex;
        align-items: center;
        gap: 0.375rem;
      }
      .footer-text a {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s;
      }
      .footer-text a:hover { color: var(--accent); }

      .footer-npub {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        color: var(--ink-subtle);
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
        font-family: inherit;
        transition: color 0.15s;
      }
      .footer-npub:hover { color: var(--ink-muted); }
      .footer-npub code {
        font-family: ui-monospace, 'SF Mono', monospace;
        font-size: 0.75rem;
      }

      /* ── Page enter animation ─────────────────────────── */
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .page-enter {
        animation: fadeUp 0.4s ease-out both;
      }

      /* ── Author profile block (used on index) ─────────── */
      .author-block {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 3.5rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
      }
      .author-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        border: 2px solid var(--border);
      }
      .author-avatar-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--surface-alt);
        border: 2px solid var(--border);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--ink-muted);
      }
      .author-info {}
      .author-name {
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: -0.01em;
        line-height: 1.3;
      }
      .author-bio {
        margin-top: 0.25rem;
        font-size: 0.9rem;
        color: var(--ink-muted);
        line-height: 1.5;
      }
      .author-social {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.6rem;
        flex-wrap: wrap;
      }
      .author-social a {
        font-size: 0.8125rem;
        color: var(--ink-subtle);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s;
      }
      .author-social a:hover { color: var(--ink); }

      /* ── Selection highlight ──────────────────────────── */
      ::selection {
        background: var(--selection);
        color: var(--selection-ink);
      }

      /* ── Shared article list (index / author / tag) ─── */
      .post-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .post-item {
        border-bottom: 1px solid var(--border-light);
      }

      .post-link {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1.25rem 0;
        text-decoration: none;
        color: inherit;
        transition: opacity 0.15s ease;
      }
      .post-link:hover { opacity: 0.75; }

      .post-link--with-thumb { gap: 1.25rem; }

      .post-thumb {
        width: 72px;
        height: 54px;
        border-radius: var(--radius-sm);
        object-fit: cover;
        border: 1px solid var(--border);
        flex-shrink: 0;
        order: -1;
      }

      .post-body {
        flex: 1;
        min-width: 0;
      }

      .post-title {
        font-size: 1.0625rem;
        font-weight: 650;
        color: var(--ink);
        letter-spacing: -0.02em;
        line-height: 1.4;
        margin-bottom: 0.3rem;
      }

      .post-summary {
        font-size: 0.875rem;
        color: var(--ink-muted);
        line-height: 1.55;
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        color: var(--ink-subtle);
      }
      .post-meta-sep { opacity: 0.35; }

      .post-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
      }
      .post-tag {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--accent);
        background: var(--surface-alt);
        padding: 0.15rem 0.5rem;
        border-radius: 100px;
        transition: color 0.15s, background 0.15s;
      }
      .post-tag:hover {
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 12%, var(--surface));
      }

      /* ── Theme toggle ────────────────────────────────── */
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-muted);
        cursor: pointer;
        font-family: inherit;
        transition: color 0.15s, background 0.15s, border-color 0.15s;
      }
      .theme-toggle:hover {
        color: var(--ink);
        border-color: var(--ink-subtle);
        background: var(--surface-alt);
      }
      .theme-toggle svg { width: 15px; height: 15px; }
      .theme-toggle .icon-sun { display: none; }
      :root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
      :root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="header-inner">
        <a href="{{ pathPrefix }}" class="header-brand" aria-label="{{ site.title }} — Home">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5zm0 2.18l7 3.82v8c0 4.1-2.69 7.93-7 9.17-4.31-1.24-7-5.07-7-9.17V8l7-3.82z"/><path d="M12 6.5L6.5 9.5v5c0 2.76 1.79 5.32 5.5 6.17 3.71-.85 5.5-3.41 5.5-6.17v-5L12 6.5z"/></svg>
          <span>{{ site.title }}</span>
        </a>
        <nav class="header-nav" aria-label="Site navigation">
          <a href="{{ pathPrefix }}" class="header-nav-link">Blog</a>
          {% if author.profile.website %}
          <a href="{{ author.profile.website }}" target="_blank" rel="noopener noreferrer" class="header-nav-link">Website</a>
          {% endif %}
          {% if author.npub %}
          <a href="https://nosta.me/{{ author.npub }}" target="_blank" rel="noopener noreferrer" class="header-nav-link">Nostr</a>
          {% endif %}
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <svg class="icon-moon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </button>
        </nav>
      </div>
    </header>


    <main id="main-content" class="site-main page-enter" role="main">
      {% block content %}{% endblock %}
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="footer-inner">
        <p class="footer-text">
          Built with <a href="https://github.com/besoeasy/NostrPress" target="_blank" rel="noopener noreferrer">NostrPress</a>
        </p>
        {% if author and author.npub %}
        <button
          class="footer-npub"
          onclick="navigator.clipboard.writeText('{{ author.npub }}'); this.querySelector('span').textContent='Copied!'; setTimeout(()=>this.querySelector('span').textContent='{{ author.npub | truncate(20) }}…', 2000)"
          aria-label="Copy Nostr public key"
          title="{{ author.npub }}"
        >
          <svg width="13" height="13" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/></svg>
          <code><span>{{ author.npub | truncate(20) }}…</span></code>
        </button>
        {% endif %}
      </div>
    </footer>

    <script src="{{ pathPrefix }}js/site.js" defer></script>
  </body>
</html>
