{
  "name": "nostrpress",
  "version": "0.0.1",
  "description": "Turn your Nostr long-form posts (NIP-23) into a fast, standalone static blog.",
  "author": "Aman Singh Kattal (https://besoeasy.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/besoeasy/NostrPress.git"
  },
  "bugs": {
    "url": "https://github.com/besoeasy/NostrPress/issues"
  },
  "homepage": "https://github.com/besoeasy/NostrPress#readme",
  "keywords": [
    "nostr",
    "nip-23",
    "static-site-generator",
    "ssg",
    "blog",
    "markdown",
    "bitcoin",
    "lightning",
    "decentralized"
  ],
  "private": false,
  "type": "module",
  "main": "src/cli.js",
  "scripts": {
    "build": "rimraf blog && node src/cli.js",
    "dev": "serve blog -p 3000"
  },
  "bin": {
    "nostrpress": "bin/nostrpress.js"
  },
  "files": [
    "bin",
    "src",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.2.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "mime-types": "^2.1.35",
    "nostr-tools": "^2.8.2",
    "nunjucks": "^3.2.4",
    "sanitize-html": "^2.13.0",
    "slugify": "^1.6.6",
    "tailwindcss": "^3.4.10",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.7",
    "serve": "^14.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
